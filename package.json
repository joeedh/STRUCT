{
  "name": "nstructjs",
  "author": "Joseph Eagar",
  "version": "0.8.11",
  "main": "build/nstructjs_es6.js",
  "index": "build/nstructjs_es6.js",
  "types": "build/structjs.d.ts",
  "exports": {
    ".": {
      "types": "./build/structjs.d.ts",
      "default": "./build/nstructjs_es6.js"
    },
    "./src": {
      "types": "./src/structjs.ts",
      "default": "./src/structjs.ts"
    },
    "./src/*": "./src/*",
    "./build/*": "./build/*",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "tinyeval/tinyeval.js",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "description": "ProtoBuf-like serialization system optimized for JS",
  "repository": "git://github.com/joeedh/STRUCT.git",
  "dependencies": {
    "acorn": "^7.4.1",
    "acorn-walk": "^7.1.1"
  },
  "scripts": {
    "build": "node tools/build.js",
    "build:package": "node tools/build_package.js",
    "build:package:dry": "node tools/build_package.js --dry-run",
    "release": "pnpm build && git commit -a && git push &&  \"node tools/publish.js\"",
    "release:dry": "node tools/publish.js --dry-run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "format": "npx @pathtx/prettier --write \"src/**/*.{ts,js}\" && npx @pathtx/prettier --write \"tests/**/*.{ts,js}\"",
    "format:check": "npx @pathtx/prettier --check \"src/**/*.{ts,js}\" && npx @pathtx/prettier --check \"tests/**/*.{ts,js}\""
  },
  "license": "unlicense",
  "type": "module",
  "devDependencies": {
    "@babel/parser": "^7.23.3",
    "@babel/traverse": "^7.23.3",
    "@pathtx/prettier": "3.3.0-dev",
    "@types/node": "^25.5.0",
    "babel": "^6.23.0",
    "esbuild": "^0.27.7",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
